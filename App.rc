#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "assets/app-icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "hdd-noise - 机械硬盘声音模拟器\0"
            VALUE "FileVersion", APP_VERSION_TEXT "\0"
            VALUE "InternalName", "hdd-noise\0"
            VALUE "OriginalFilename", "hdd-noise.exe\0"
            VALUE "ProductName", "hdd-noise\0"
            VALUE "ProductVersion", "0.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
